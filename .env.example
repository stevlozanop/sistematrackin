# Base de datos PostgreSQL (Supabase)
# Supabase → Connect → «Session pooler» (puerto 5432) para tu PC y para copiar los datos.
# En Vercel no hace falta: la integración de Supabase crea POSTGRES_URL (puerto 6543) y el sistema la usa sola.
DATABASE_URL=postgres://postgres.xxxxxxxx:TU-CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# DB_SSL_CA=          # opcional: certificado de Supabase (Settings → Database → SSL) para verificar la conexión
# DB_POOL_LIMIT=3     # conexiones por función (en Vercel ya es 3)

# Solo para copiar los datos desde XAMPP una vez (npm run db:migrar)
MYSQL_URL=mysql://root@127.0.0.1:3306/system_trackin

# Sesión: una clave larga y aleatoria (en Vercel es obligatoria)
AUTH_SECRET=cambia-esto

# Usuario dev inicial (se crea si no existe)
DEV_EMAIL=dev@trackin.local
DEV_PASSWORD=Dev12345!
