# Base de datos MySQL
# Local (XAMPP / Workbench):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=system_trackin
# En la nube (Vercel): basta con DATABASE_URL, que reemplaza a las DB_* de arriba
# DATABASE_URL=mysql://usuario:clave@host:puerto/system_trackin
# DB_SSL=true          # obligatorio en Aiven, TiDB Cloud y la mayoría de bases en la nube
# DB_POOL_LIMIT=3      # conexiones por función (en Vercel ya es 3 por defecto)

# Sesión: una clave larga y aleatoria (en Vercel es obligatoria)
AUTH_SECRET=cambia-esto

# Usuario dev inicial (se crea si no existe)
DEV_EMAIL=dev@trackin.local
DEV_PASSWORD=Dev12345!
